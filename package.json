{
  "name": "pixice",
  "version": "0.1.0-beta.2",
  "description": "A cross-platform desktop client for working with coding agents.",
  "author": {
    "name": "Pixice contributors",
    "email": "74672342+Blumenwagen@users.noreply.github.com"
  },
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.20.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "service": "node electron/backend/cli.mjs",
    "dev:electron": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build --mode sites && node scripts/prepare-sites-build.mjs",
    "build:desktop": "node scripts/verify-github-cli.mjs --current && vite build --mode desktop && pnpm verify:desktop-renderer && electron-builder --config electron-builder.config.cjs",
    "install:local:macos": "node scripts/install-local-macos.mjs",
    "github:sync": "node scripts/sync-github-cli.mjs",
    "github:verify": "node scripts/verify-github-cli.mjs",
    "release:verify": "node scripts/verify-release-version.mjs",
    "release:preflight": "node scripts/verify-release-readiness.mjs && node scripts/verify-ios-preview.mjs",
    "verify:ios-preview": "node scripts/verify-ios-preview.mjs",
    "verify:desktop-renderer": "node scripts/verify-desktop-renderer.cjs",
    "release:verify:macos": "node scripts/verify-packaged-macos.mjs",
    "release:checksums": "node scripts/generate-checksums.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:sites": "vite build --mode sites && node scripts/prepare-sites-build.mjs && node --test tests/sites-worker.test.mjs",
    "check": "vitest run && pnpm test:sites"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.234",
    "@xyflow/react": "^12.11.3",
    "electron-updater": "6.8.9",
    "motion": "^13.1.0",
    "ms": "2.1.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/manrope": "5.2.8",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.1",
    "electron": "38.7.2",
    "electron-builder": "26.0.12",
    "jsdom": "27.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "vitest": "3.2.4",
    "wait-on": "8.0.5"
  },
  "main": "electron/main.mjs"
}
