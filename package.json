{
  "name": "loom",
  "version": "0.0.0",
  "description": "A cross-platform desktop client for orchestrating Codex agents.",
  "author": "Loom contributors",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:desktop": "vite build && electron-builder",
    "runtime:verify": "node scripts/verify-runtime.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check": "vitest run && vite build && node scripts/prepare-sites-build.mjs && node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/manrope": "5.2.8",
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "concurrently": "9.2.1",
    "electron": "38.7.2",
    "electron-builder": "26.0.12",
    "jsdom": "27.0.0",
    "vitest": "3.2.4",
    "wait-on": "8.0.5"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.loom.orchestrator",
    "productName": "Loom",
    "icon": "build/icon.png",
    "asar": true,
    "directories": { "output": "release" },
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/runtime",
        "to": "runtime",
        "filter": ["**/*"]
      }
    ],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools" },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage", "deb"], "category": "Development" }
  }
}
